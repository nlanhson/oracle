# Oracle look. Owned by repo; edit ~/.config/ghostty/config instead.
background = 0a0a0a
foreground = c8c8c8
cursor-color = 00e5ff
selection-background = 1f3a40
selection-foreground = ffffff
palette = 0=0a0a0a
palette = 1=8b2e2e
palette = 2=7a9a7a
palette = 3=b5a46a
palette = 4=4a7a8c
palette = 5=8a6a8c
palette = 6=00e5ff
palette = 7=c8c8c8
palette = 8=4a4a4a
palette = 9=a33a3a
palette = 10=9ab89a
palette = 11=d4c27f
palette = 12=6aa0b5
palette = 13=a888aa
palette = 14=7ff2ff
palette = 15=ffffff
window-decoration = none
gtk-titlebar = false
window-padding-x = 8
window-padding-y = 6
cursor-style-blink = false
confirm-close-surface = false
# alt+1..4 = tmux workspaces, not ghostty tabs
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
