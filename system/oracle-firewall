#!/usr/bin/env bash
# Oracle firewall (ufw): nothing gets in except Tailscale. LLMNR off (no name answers to the local network). Re-runnable, as root.
# oracle-firewall [--now]   --now = apply right away (not in the USB installer's chroot)
set -euo pipefail
ufw default deny incoming >/dev/null
ufw default allow outgoing >/dev/null
ufw allow in on tailscale0 comment tailscale >/dev/null
ufw allow 41641/udp comment tailscale >/dev/null
mkdir -p /etc/systemd/resolved.conf.d
printf '[Resolve]\nLLMNR=no\n' >/etc/systemd/resolved.conf.d/oracle-resolved.conf
if [[ ${1:-} == --now ]]; then
  ufw --force enable >/dev/null
  systemctl enable ufw.service
  systemctl try-restart systemd-resolved.service || true
else
  sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
  systemctl enable ufw.service
fi
