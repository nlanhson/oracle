#!/usr/bin/env bash
# Oracle home dashboard (tmux window 0). Widgets: default/home/<name>.sh, each defines w_<name>. Keys: g gui, c code, u update.
H=$(dirname "$(readlink -f "$0")")/../default/home
WIDGETS=(header system server claude footer calendar)
# shellcheck disable=SC1090
for f in "$H"/theme.sh "${WIDGETS[@]/#/$H/}"; do [[ $f == *.sh ]] || f+=.sh; source "$f"; done
printf '\e[?25l'; trap 'printf "\\e[?25h"' EXIT
while :; do
  printf '\e[H\e[2J'
  for w in "${WIDGETS[@]}"; do "w_$w"; done
  printf '\e[30;1H'
  read -rsn1 -t 2 k || continue
  case $k in
    g) oracle gui ;;
    c) tmux new-window -n code ;;
    u) tmux new-window -n update 'oracle update; read -rp "enter to close"' ;;
  esac
done
