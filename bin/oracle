#!/usr/bin/env bash
# oracle update | backup <dir> | restore <dir> | battery [n] | files | settings | open <file> | gui | shell | home | attach | session | help
set -euo pipefail
DIR=$HOME/.local/share/oracle
STATE=$HOME/.local/state/oracle/migrations
MODE=$HOME/.local/state/oracle/mode
say() { printf '\e[36m::\e[0m %s\n' "$*"; }
die() { printf '\e[31m!! %s\e[0m\n' "$*" >&2; exit 1; }

case ${1:-help} in
  update)
    say "oracle: pull"
    git -C "$DIR" pull -q --ff-only || die "can't pull $DIR (local changes?). Fix, then rerun."
    mkdir -p "$STATE"
    for m in "$DIR"/migrations/*.sh; do
      [[ -f $m && ! -f $STATE/${m##*/} ]] || continue
      say "migration ${m##*/}"
      bash "$m" || die "migration ${m##*/} failed"
      touch "$STATE/${m##*/}"
    done
    bash "$DIR/install.sh"
    if command -v yay >/dev/null; then say "AUR updates"; yay -Sua --noconfirm; fi
    [[ -d /usr/lib/modules/$(uname -r) ]] || say "kernel updated: reboot soon"
    ;;
  backup) shift; bash "$DIR/server/server.sh" backup "$@" ;;
  restore) shift; exec bash "$DIR/install.sh" --restore "${1:?usage: oracle restore <backup folder>}" ;;
  session) # tty1 login: shell (cage + ghostty + tmux) ⇄ gui (Hyprland). Same mode after exit = logout.
    mkdir -p "${MODE%/*}"; echo shell >"$MODE"
    while :; do
      m=$(<"$MODE")
      if [[ $m == gui ]]; then start-hyprland || true; else cage -s -- ghostty -e oracle attach || true; fi
      [[ $(<"$MODE") != "$m" ]] || break
    done ;;
  attach) tmux has -t oracle 2>/dev/null || tmux new -d -s oracle -n home oracle home
    oracle tabs; exec tmux attach -t oracle \; select-window -t oracle:1 ;;
  tabs) # workspaces 1-4 always exist: 1 = home dashboard, 2-4 = terminals
    for i in 1 2 3 4; do
      tmux list-windows -t oracle -F '#I' 2>/dev/null | grep -qx "$i" && continue
      if ((i == 1)); then tmux new-window -d -t oracle:1 -n home oracle home; else tmux new-window -d -t "oracle:$i"; fi
    done 2>/dev/null || true ;;
  home) exec "$DIR/bin/oracle-home" ;;
  files) shift; exec "$DIR/bin/oracle-files" "$@" ;;
  settings) exec "$DIR/bin/oracle-settings" ;;
  open) f=$(realpath "${2:?usage: oracle open <file>}") # in the desktop (default app); from Shell mode: switch, then open
    if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then setsid -f xdg-open "$f" >/dev/null 2>&1; exit; fi
    echo "$f" >"${MODE%/*}/open"; exec "$0" gui ;;
  pending) P=${MODE%/*}/open # Hyprland start: open what `oracle open` asked for
    [[ -f $P ]] && { f=$(<"$P"); rm -f "$P"; setsid -f xdg-open "$f" >/dev/null 2>&1; } || true ;;
  battery) L=/etc/oracle/battery-limit
    if [[ -n ${2:-} ]]; then
      [[ $2 =~ ^[0-9]+$ ]] && ((${2} >= 20 && ${2} <= 100)) || die "usage: oracle battery <20-100>"
      if [[ -w $L ]]; then echo "$2" >"$L"; else echo "$2" | sudo tee "$L" >/dev/null; sudo systemctl start oracle-battery.service; fi
    fi
    echo "battery stops charging at $(cat "$L" 2>/dev/null || echo 100)%" ;;
  gui) echo gui >"$MODE"; pkill -x cage ;;
  shell) echo shell >"$MODE"; hyprctl dispatch 'hl.dsp.exit()' >/dev/null ;;
  *) echo "oracle gui           switch to GUI (Hyprland). Shell keeps running in tmux"
     echo "oracle shell         back to Shell (closes GUI apps). Super+M in GUI"
     echo "oracle update        get newest Oracle + system updates"
     echo "oracle backup <dir>  server backup (photos, db, settings, tailscale)"
     echo "oracle restore <dir> bring the server back from a backup"
     echo "oracle battery [n]   show or set the charge limit (20-100%)"
     echo "oracle files [dir]   file browser"
     echo "oracle settings      settings (brightness, sound, wifi, bluetooth, battery, about)"
     echo "oracle open <file>   open a file in the desktop" ;;
esac
