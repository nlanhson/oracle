#!/usr/bin/env bash
# oracle update | rollback | backup <dir> | restore <dir> | battery [n] | files | settings | open <file> | gui | shell
#        internal: home attach tabs session pending look night idle wall set get
set -euo pipefail
DIR=$HOME/.local/share/oracle
STATE=$HOME/.local/state/oracle/migrations
MODE=$HOME/.local/state/oracle/mode
SET=$HOME/.config/oracle/settings
say() { printf '\e[36m::\e[0m %s\n' "$*"; }
die() { printf '\e[31m!! %s\e[0m\n' "$*" >&2; exit 1; }

case ${1:-help} in
  update)
    snap() { command -v snapper >/dev/null && sudo snapper -c root create -c number -p -d "$@" 2>/dev/null; } # rollback point
    PRE=$(snap "oracle update" -t pre || true)
    trap '[[ -n $PRE ]] && snap "oracle update" -t post --pre-number "$PRE" >/dev/null || true' EXIT
    say "oracle: pull"
    git -C "$DIR" pull -q --ff-only || die "can't pull $DIR (local changes?). Fix, then rerun."
    mkdir -p "$STATE"
    for m in "$DIR"/migrations/*.sh; do
      [[ -f $m && ! -f $STATE/${m##*/} ]] || continue
      say "migration ${m##*/}"
      bash "$m" || die "migration ${m##*/} failed"
      touch "$STATE/${m##*/}"
    done
    say "system: pacman -Syu"; sudo pacman -Syu --noconfirm
    bash "$DIR/install.sh"
    if command -v yay >/dev/null; then say "AUR updates"; yay -Sua --noconfirm; fi
    if command -v fwupdmgr >/dev/null; then # BIOS, SSD, touchpad… when the maker publishes updates (LVFS)
      say "firmware"; sudo fwupdmgr refresh --force &>/dev/null || true
      sudo fwupdmgr update -y --no-reboot-check 2>&1 | grep -vE '^(Devices with no available firmware|  •|WARNING: Firmware metadata)' || true
    fi
    [[ -d /usr/lib/modules/$(uname -r) ]] || say "kernel updated: reboot soon"
    ;;
  rollback) # booted an older snapshot from the boot menu → make it the system. Else: pick an update, put back the files it changed
    if grep -q '/\.snapshots/' /proc/cmdline; then exec sudo limine-snapper-restore; fi
    command -v snapper >/dev/null && sudo snapper -c root list >/dev/null 2>&1 || die "no snapshots on this system"
    mapfile -t U < <(sudo snapper -c root --csvout list --columns number,type,pre-number,date,description |
      awk -F, '$2 == "post" {print $3 "," $1 "," substr($4, 1, 16) "," $5}' | tac | head -15)
    ((${#U[@]})) || die "nothing to roll back yet"
    say "updates, newest first:"
    for i in "${!U[@]}"; do IFS=, read -r _ _ d t <<<"${U[i]}"; printf '  %2d  %s  %s\n' $((i + 1)) "$d" "${t:0:60}"; done
    read -rp "roll back which (number, Enter = cancel): " n
    [[ $n =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#U[@]})) || exit 0
    IFS=, read -r a b d t <<<"${U[n - 1]}"
    PRE=$(sudo snapper -c root create -c number -p -t pre -d "rollback $d")
    sudo snapper -c root undochange "$a..$b" >/dev/null || die "rollback failed"
    sudo snapper -c root create -c number -t post --pre-number "$PRE" -d "rollback $d"
    if command -v limine-update >/dev/null; then sudo limine-update >/dev/null # kernel went back too: matching boot entry
    else for k in /usr/lib/modules/*/pkgbase; do
      [[ $(<"$k") == linux ]] || continue; k=${k%/pkgbase}
      sudo cmp -s "$k/vmlinuz" /boot/vmlinuz-linux || { sudo install -m644 "$k/vmlinuz" /boot/vmlinuz-linux; sudo mkinitcpio -P; }
    done; fi
    say "rolled back ($d · ${t:0:40}). Restart now: systemctl reboot. Changed your mind? oracle rollback again, pick \"rollback $d\"" ;;
  backup) shift; bash "$DIR/server/server.sh" backup "$@" ;;
  restore) shift; exec bash "$DIR/install.sh" --restore "${1:?usage: oracle restore <backup folder>}" ;;
  session) # tty1 login: shell (cage + ghostty + tmux) ⇄ gui (Hyprland). Same mode after exit = logout.
    mkdir -p "${MODE%/*}"; echo shell >"$MODE"
    while :; do
      m=$(<"$MODE"); "$0" look
      if [[ $m == gui ]]; then start-hyprland || true; else XKB_DEFAULT_LAYOUT=$("$0" get keyboard us) cage -s -- ghostty -e oracle attach || true; fi
      [[ $(<"$MODE") != "$m" ]] || break
    done ;;
  attach) tmux has -t oracle 2>/dev/null || tmux new -d -s oracle -n home oracle home
    oracle tabs; oracle look; oracle night; oracle idle; exec tmux attach -t oracle \; select-window -t oracle:1 ;;
  tabs) # workspaces 1-4 always exist: 1 = home dashboard, 2-4 = terminals
    for i in 1 2 3 4; do
      tmux list-windows -t oracle -F '#I' 2>/dev/null | grep -qx "$i" && continue
      if ((i == 1)); then tmux new-window -d -t oracle:1 -n home oracle home; else tmux new-window -d -t "oracle:$i"; fi
    done 2>/dev/null || true ;;
  home) exec "$DIR/bin/oracle-home" ;;
  files) shift; exec "$DIR/bin/oracle-files" "$@" ;;
  settings) exec "$DIR/bin/oracle-settings" ;;
  open) f=$(realpath "${2:?usage: oracle open <file>}") # in the desktop (default app); from Shell mode: switch, then open
    if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then setsid -f xdg-open "$f" >/dev/null 2>&1; exit; fi
    echo "$f" >"${MODE%/*}/open"; exec "$0" gui ;;
  pending) P=${MODE%/*} # Hyprland start: wallpaper, night light, file `oracle open` asked for
    "$0" wall; "$0" night
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true # GTK apps: dark, grey accent (monochrome)
    gsettings set org.gnome.desktop.interface accent-color slate 2>/dev/null || true
    [[ -f $P/open ]] && { f=$(<"$P/open"); rm -f "$P/open"; setsid -f xdg-open "$f" >/dev/null 2>&1; } || true ;;
  set) mkdir -p "${SET%/*}"; touch "$SET" # set <key> [value]: ~/.config/oracle/settings (settings screen)
    { grep -v "^${2:?}=" "$SET" || true; [[ -z ${3:-} ]] || printf '%s=%s\n' "$2" "$3"; } >"$SET.new"; mv "$SET.new" "$SET" ;;
  get) v=$(sed -n "s/^${2:?}=//p" "$SET" 2>/dev/null | tail -1) || true; echo "${v:-${3:-}}" ;; # get <key> [default]
  look) # text size + accent → ghostty include, tmux colors
    # shellcheck disable=SC1091
    source "$DIR/default/home/theme.sh"; a=$A; mkdir -p "${SET%/*}"
    printf 'font-size = %s\ncursor-color = %s\n' "$("$0" get textsize 12)" "$a" >"${SET%/*}/ghostty.new"
    cmp -s "${SET%/*}/ghostty.new" "${SET%/*}/ghostty" && rm "${SET%/*}/ghostty.new" || { mv "${SET%/*}/ghostty.new" "${SET%/*}/ghostty"; pkill -USR2 -x ghostty || true; }
    tmux set -g @accent "#$a" \; set -g pane-active-border-style "fg=#$a" \; set -g message-style "bg=#0a0a0a,fg=#$a" 2>/dev/null || true ;;
  wall) pkill -x swaybg || true; [[ -n ${WAYLAND_DISPLAY:-} ]] || exit 0 # desktop wallpaper (settings), else black
    w=$("$0" get wallpaper); if [[ -f $w ]]; then setsid -f swaybg -i "$w" -m fill &>/dev/null; else setsid -f swaybg -c 000000 &>/dev/null; fi ;;
  idle) pkill -x swayidle || true; [[ -n ${WAYLAND_DISPLAY:-} ]] || exit 0 # Shell mode: dim at 5 min, screen off at 7. Never sleeps (server)
    setsid -f swayidle timeout 300 'brightnessctl -q -s set 10%' resume 'brightnessctl -q -r' \
      timeout 420 'brightnessctl -q set 0' resume 'brightnessctl -q -r' &>/dev/null ;;
  night) pkill -x wlsunset || true # night light (settings): warm screen in the evening or always
    [[ -n ${WAYLAND_DISPLAY:-} ]] || exit 0
    case $("$0" get nightlight off) in
      evening) setsid -f wlsunset -t 4000 -T 6500 -S 06:00 -s 18:00 -d 1800 &>/dev/null ;;
      always) setsid -f wlsunset -t 4000 -T 4001 -S 06:00 -s 18:00 &>/dev/null ;;
    esac ;;
  battery) L=/etc/oracle/battery-limit
    if [[ -n ${2:-} ]]; then
      [[ $2 =~ ^[0-9]+$ ]] && ((${2} >= 20 && ${2} <= 100)) || die "usage: oracle battery <20-100>"
      if [[ -w $L ]]; then echo "$2" >"$L"; else echo "$2" | sudo tee "$L" >/dev/null; sudo systemctl start oracle-battery.service; fi
    fi
    echo "battery stops charging at $(cat "$L" 2>/dev/null || echo 100)%" ;;
  gui) echo gui >"$MODE"; pkill -x cage ;;
  shell) echo shell >"$MODE"; hyprctl dispatch 'hl.dsp.exit()' >/dev/null ;;
  *) echo "oracle gui           switch to GUI (Hyprland). Shell keeps running in tmux"
     echo "oracle shell         back to Shell (closes GUI apps). Super+M in GUI"
     echo "oracle update        update everything: Oracle, all programs (pacman -Syu, AUR), firmware. Saves a rollback point first"
     echo "oracle rollback      take back an update (pick one from the list), then restart"
     echo "oracle backup <dir>  server backup (photos, db, settings, tailscale)"
     echo "oracle restore <dir> bring the server back from a backup"
     echo "oracle battery [n]   show or set the charge limit (20-100%)"
     echo "oracle files [dir]   file browser"
     echo "oracle settings      settings (brightness, sound, wifi, bluetooth, battery, about)"
     echo "oracle open <file>   open a file in the desktop" ;;
esac
