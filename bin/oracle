#!/usr/bin/env bash
# oracle <command>: every command is listed (what, when, example) in bin/oracle-manual. test/manual.sh checks none is missing.
set -euo pipefail
DIR=$HOME/.local/share/oracle ME=$(dirname "$(readlink -f "$0")")
STATE=$HOME/.local/state/oracle/migrations
MODE=$HOME/.local/state/oracle/mode
SET=$HOME/.config/oracle/settings
say() { printf '\e[36m::\e[0m %s\n' "$*"; }
die() { printf '\e[31m!! %s\e[0m\n' "$*" >&2; exit 1; }
hypr() { # running desktop → its env (Shell-mode tmux started before it, so its own env is stale)
  local l; l=$(hyprctl instances 2>/dev/null | awk '/^instance /{i=substr($2, 1, length($2) - 1)} /wl socket:/{print i, $3; exit}')
  [[ -n $l ]] && export HYPRLAND_INSTANCE_SIGNATURE=${l% *} WAYLAND_DISPLAY=${l#* }
}
shown() { hyprctl monitors | grep -q 'special workspace: .*(special:shell)'; } # Shell mode over the desktop

case ${1:-help} in
  update)
    snap() { command -v snapper >/dev/null && sudo snapper -c root create -c number -p -d "$@" 2>/dev/null; } # rollback point
    PRE=$(snap "oracle update" -t pre || true)
    trap '[[ -n $PRE ]] && snap "oracle update" -t post --pre-number "$PRE" >/dev/null || true' EXIT
    say "oracle: pull"
    git -C "$DIR" pull -q --ff-only || die "can't pull $DIR (local changes?). Fix, then rerun."
    mkdir -p "$STATE"
    for m in "$DIR"/migrations/*.sh; do
      [[ -f $m && ! -f $STATE/${m##*/} ]] || continue
      say "migration ${m##*/}"
      bash "$m" || die "migration ${m##*/} failed"
      touch "$STATE/${m##*/}"
    done
    say "system: pacman -Syu"; sudo pacman -Syu --noconfirm
    bash "$DIR/install.sh"
    if command -v yay >/dev/null; then say "AUR updates"; yay -Sua --noconfirm; fi
    if command -v fwupdmgr >/dev/null; then # BIOS, SSD, touchpad… when the maker publishes updates (LVFS)
      say "firmware"; sudo fwupdmgr refresh --force &>/dev/null || true
      sudo fwupdmgr update -y --no-reboot-check 2>&1 | grep -vE '^(Devices with no available firmware|  •|WARNING: Firmware metadata)' || true
    fi
    [[ -d /usr/lib/modules/$(uname -r) ]] || say "kernel updated: reboot soon"
    ;;
  rollback) # booted an older snapshot from the boot menu → make it the system. Else: pick an update, put back the files it changed
    if grep -q '/\.snapshots/' /proc/cmdline; then exec sudo limine-snapper-restore; fi
    command -v snapper >/dev/null && sudo snapper -c root list >/dev/null 2>&1 || die "no snapshots on this system"
    mapfile -t U < <(sudo snapper -c root --csvout list --columns number,type,pre-number,date,description |
      awk -F, '$2 == "post" {print $3 "," $1 "," substr($4, 1, 16) "," $5}' | tac | head -15)
    ((${#U[@]})) || die "nothing to roll back yet"
    say "updates, newest first:"
    for i in "${!U[@]}"; do IFS=, read -r _ _ d t <<<"${U[i]}"; printf '  %2d  %s  %s\n' $((i + 1)) "$d" "${t:0:60}"; done
    read -rp "roll back which (number, Enter = cancel): " n
    [[ $n =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#U[@]})) || exit 0
    IFS=, read -r a b d t <<<"${U[n - 1]}"
    PRE=$(sudo snapper -c root create -c number -p -t pre -d "rollback $d")
    sudo snapper -c root undochange "$a..$b" >/dev/null || die "rollback failed"
    sudo snapper -c root create -c number -t post --pre-number "$PRE" -d "rollback $d"
    if command -v limine-update >/dev/null; then sudo limine-update >/dev/null # kernel went back too: matching boot entry
    else for k in /usr/lib/modules/*/pkgbase; do
      [[ $(<"$k") == linux ]] || continue; k=${k%/pkgbase}
      sudo cmp -s "$k/vmlinuz" /boot/vmlinuz-linux || { sudo install -m644 "$k/vmlinuz" /boot/vmlinuz-linux; sudo mkinitcpio -P; }
    done; fi
    say "rolled back ($d · ${t:0:40}). Restart now: systemctl reboot. Changed your mind? oracle rollback again, pick \"rollback $d\"" ;;
  backup) shift; bash "$DIR/server/server.sh" backup "$@" ;;
  restore) shift; exec bash "$DIR/install.sh" --restore "${1:?usage: oracle restore <backup folder>}" ;;
  session) # tty1 login: shell (cage + ghostty + tmux) → gui (Hyprland, then Shell mode = full-screen window in it). Same mode after exit = logout.
    mkdir -p "${MODE%/*}"; echo shell >"$MODE"
    while :; do
      m=$(<"$MODE"); "$0" look
      if [[ $m == gui ]]; then start-hyprland || true; else XKB_DEFAULT_LAYOUT=$("$0" get keyboard us) cage -s -- ghostty -e oracle attach || true; fi
      [[ $(<"$MODE") != "$m" ]] || break
    done ;;
  attach) tmux has -t oracle 2>/dev/null || tmux new -d -s oracle -n home oracle home
    oracle tabs; oracle look; oracle night; oracle idle; exec tmux attach -t oracle \; select-window -t oracle:1 ;;
  tabs) # workspaces 1-4 always exist: 1 = home dashboard, 2-4 = terminals
    for i in 1 2 3 4; do
      tmux list-windows -t oracle -F '#I' 2>/dev/null | grep -qx "$i" && continue
      if ((i == 1)); then tmux new-window -d -t oracle:1 -n home oracle home; else tmux new-window -d -t "oracle:$i"; fi
    done 2>/dev/null || true ;;
  shot) # shot [region|screen|window]: save to ~/Pictures/Screenshots + clipboard, then a thumbnail with Copy / Edit
    hypr; D=$HOME/Pictures/Screenshots; mkdir -p "$D"; F="$D/Screenshot $(date +'%F at %-I.%M.%S %p').png"
    case ${2:-region} in region) M=(-m region) ;; screen) M=(-m active -m output) ;; window) M=(-m active -m window) ;; *) die "usage: oracle shot [region|screen|window]" ;; esac
    hyprshot "${M[@]}" -s -o "$D" -f "${F##*/}" >/dev/null 2>&1 || true
    [[ -s $F ]] || exit 0 # Esc = nothing saved, nothing shown
    A=(-A default=Open -A copy=Copy); command -v satty >/dev/null && A+=(-A edit=Edit)
    ( r=$(notify-send -a Screenshot -u low -t 6000 -w "${A[@]}" -h "string:image-path:$F" "Screenshot saved" "${F##*/}" 2>/dev/null) || true
      case $r in
        copy) wl-copy --type image/png <"$F" ;;
        edit) satty --filename "$F" --output-filename "${F%.png}-edited.png" --copy-command wl-copy --early-exit ;;
        default) setsid -f xdg-open "$F" >/dev/null 2>&1 ;;
      esac ) >/dev/null 2>&1 </dev/null & disown ;;
  home) W=${MODE%/*}/done/welcome # the first start after a fresh install shows the welcome guide once; if it fails the dashboard still comes up
    [[ -f $W ]] || { mkdir -p "${W%/*}"; touch "$W"; "$ME/oracle-welcome" || true; }
    exec "$DIR/bin/oracle-home" ;;
  welcome) exec "$ME/oracle-welcome" ;;
  files) shift; exec "$DIR/bin/oracle-files" "$@" ;;
  settings) exec "$DIR/bin/oracle-settings" "${@:2}" ;;
  panel) # Control Center (Quickshell panel in default/quickshell): no argument = open/close. Helpers it uses: <wifi|bt|dnd|night|mute> [true|false] (no value = print state), state, vol/bright <5-100>, display, output, charge [20-100], settings [item], power, quiet (loop)
    v=${3:-} o=off; [[ $v == true ]] && o=on
    st() { if eval "$1"; then echo true; else echo false; fi; }
    qs_() { qs -p "$DIR/default/quickshell" "$@"; }
    case ${2:-} in
      "" | toggle | open | close) c=${2:-toggle}
        qs_ ipc call panel "$c" &>/dev/null || { pgrep -x 'qs|quickshell' >/dev/null || setsid -f qs -p "$DIR/default/quickshell" &>/dev/null; for _ in {1..30}; do sleep 0.2; qs_ ipc call panel "$c" &>/dev/null && exit 0; done; die "Control Center is not running (qs -p $DIR/default/quickshell)"; } ;;
      state) # one key=value per line, read by the panel while it is open. Every outside tool gets 1 s (a missing daemon must not freeze the panel)
        t() { timeout 1 "$@"; }
        w=$(t nmcli radio wifi 2>/dev/null) || w=; [[ $w == enabled ]] && w=on || w=off
        echo "wifi=$w"; echo "ssid=$([[ $w == on ]] && t nmcli -t -f active,ssid dev wifi 2>/dev/null | sed -n 's/^yes://p;T;q' || true)"
        t bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && echo bt=on || echo bt=off
        echo "btdev=$(t bluetoothctl devices Connected 2>/dev/null | sed -n 's/^Device [^ ]* //p;T;q' || true)"
        echo "dnd=$(t swaync-client -D 2>/dev/null || echo false)"; echo "night=$("$0" get nightlight off)"
        echo "bright=$(t brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d % || true)"
        vol=$(t wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true); echo "vol=$(awk '{print int($2*100+0.5)}' <<<"$vol")"; grep -q MUTED <<<"$vol" && echo mute=true || echo mute=false
        b=$(ls -d ${ORACLE_PS:-/sys/class/power_supply}/BAT* 2>/dev/null | head -1 || true); if [[ -n $b ]]; then echo "bat=$(<"$b/capacity")"; echo "batstate=$(<"$b/status")"; echo "limit=$("$0" panel charge)"; fi
        t hyprctl monitors all 2>/dev/null | grep -A20 '^Monitor eDP-1 ' | grep -q 'dpmsStatus: 0' && echo screen=off || echo screen=on ;;
      vol) wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "${3:?usage: oracle panel vol <0-100>}%" ;;
      bright) brightnessctl -q set "${3:?usage: oracle panel bright <5-100>}%" ;;
      output) setsid -f pavucontrol --tab=3 &>/dev/null ;;
      display) if hyprctl monitors all | grep -A20 '^Monitor eDP-1 ' | grep -q 'dpmsStatus: 1'; then hyprctl dispatch 'hl.dsp.dpms({ action = "disable", monitor = "eDP-1" })'; else hyprctl dispatch 'hl.dsp.dpms({ action = "enable", monitor = "eDP-1" })'; fi >/dev/null ;;
      wifi) if [[ -n $v ]]; then nmcli radio wifi $o; else st '[[ $(nmcli radio wifi) == enabled ]]'; fi ;;
      bt) if [[ -n $v ]]; then bluetoothctl power $o >/dev/null; else st 'bluetoothctl show | grep -q "Powered: yes"'; fi ;;
      dnd) if [[ -n $v ]]; then swaync-client -d$([[ $v == true ]] && echo n || echo f) >/dev/null; else swaync-client -D; fi ;;
      night) if [[ $v == cycle ]]; then case $("$0" get nightlight off) in off) n=evening ;; evening) n=always ;; *) n= ;; esac; "$0" set nightlight $n; "$0" night
        elif [[ -n $v ]]; then "$0" set nightlight $([[ $v == true ]] && echo always); "$0" night; else st '[[ $("$0" get nightlight off) != off ]]'; fi ;;
      mute) if [[ -n $v ]]; then wpctl set-mute @DEFAULT_AUDIO_SINK@ $([[ $v == true ]] && echo 1 || echo 0); else st 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED'; fi ;;
      charge) if [[ -n $v ]]; then "$0" battery "$v" >/dev/null 2>&1 || notify-send -u low "Charge limit" "Could not change it. Try: oracle battery $v"; else cat /etc/oracle/battery-limit 2>/dev/null || echo 100; fi ;;
      settings) setsid -f ghostty --class=oracle.settings --gtk-single-instance=false --window-width=72 --window-height=30 -e oracle settings ${3:-} &>/dev/null ;;
      quiet) # no banners while the screen is locked or shared (they still collect in the panel): inhibitors, checked every 3 s. Started by the desktop
        q() { if (($2)); then swaync-client -Ia "$1" -sw; else swaync-client -Ir "$1" -sw; fi >/dev/null 2>&1; }
        l=0 c=0
        while sleep 3; do
          pidof hyprlock >/dev/null && n=1 || n=0; ((n == l)) || { q oracle-lock $n; l=$n; }
          pw-cli ls Node 2>/dev/null | grep -q xdph-streaming && n=1 || n=0; ((n == c)) || { q oracle-share $n; c=$n; }
        done ;;
      power) setsid -f bash ~/.config/fuzzel/power-menu.sh &>/dev/null ;;
      *) die "usage: oracle panel [toggle|open|close] | <wifi|bt|dnd|night|mute> [true|false] | state | vol <n> | bright <n> | display | output | charge [20-100] | settings [item] | power | quiet" ;;
    esac ;;
  doctor) exec "$DIR/bin/oracle-doctor" ;;
  manual) exec "$ME/oracle-manual" ;;
  open) f=$(realpath "${2:?usage: oracle open <file>}") # in the desktop (default app); from Shell mode: switch, then open
    if hypr; then setsid -f xdg-open "$f" >/dev/null 2>&1; exec "$0" gui; fi
    echo "$f" >"${MODE%/*}/open"; exec "$0" gui ;;
  pending) P=${MODE%/*} # Hyprland start: wallpaper, night light, file `oracle open` asked for
    "$0" wall; "$0" night
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true # GTK apps: dark, grey accent (monochrome)
    gsettings set org.gnome.desktop.interface accent-color slate 2>/dev/null || true
    [[ ! -f $HOME/.local/share/icons/Oracle/index.theme ]] || gsettings set org.gnome.desktop.interface icon-theme Oracle 2>/dev/null || true # grey folders
    gsettings set org.gnome.desktop.interface font-name 'Inter 11' 2>/dev/null || true # UI font (token font_ui); monospace stays JetBrains Mono
    [[ -f $P/open ]] && { f=$(<"$P/open"); rm -f "$P/open"; setsid -f xdg-open "$f" >/dev/null 2>&1; } || true ;;
  set) mkdir -p "${SET%/*}"; touch "$SET" # set <key> [value]: ~/.config/oracle/settings (settings screen)
    { grep -v "^${2:?}=" "$SET" || true; [[ -z ${3:-} ]] || printf '%s=%s\n' "$2" "$3"; } >"$SET.new"; mv "$SET.new" "$SET" ;;
  get) v=$(sed -n "s/^${2:?}=//p" "$SET" 2>/dev/null | tail -1) || true; echo "${v:-${3:-}}" ;; # get <key> [default]
  look) # text size + accent → ghostty include, tmux colors; tokens + accent → ~/.config/oracle/look/* (bar, launcher, panels, lock, borders, GTK)
    # shellcheck disable=SC1091
    source "$DIR/default/home/theme.sh"; a=$A; mkdir -p "${SET%/*}"
    printf 'font-size = %s\ncursor-color = %s\n' "$("$0" get textsize 12)" "$a" >"${SET%/*}/ghostty.new"
    cmp -s "${SET%/*}/ghostty.new" "${SET%/*}/ghostty" && rm "${SET%/*}/ghostty.new" || { mv "${SET%/*}/ghostty.new" "${SET%/*}/ghostty"; pkill -USR2 -x ghostty || true; }
    tmux set -g @accent "#$a" \; set -g pane-active-border-style "fg=#$a" \; set -g message-style "bg=#0a0a0a,fg=#$a" 2>/dev/null || true
    # shellcheck disable=SC1091
    source "$DIR/default/look/tokens"; [[ ! -f ${SET%/*}/tokens ]] || source "${SET%/*}/tokens"
    L=${SET%/*}/look; mkdir -p "$L"; accent=$a; ch=
    put() { cat >"$L/$1.new"; if cmp -s "$L/$1.new" "$L/$1"; then rm "$L/$1.new"; else mv "$L/$1.new" "$L/$1"; ch=1; fi; } # write only if changed
    rgb() { printf '%d,%d,%d' $((16#${1:0:2})) $((16#${1:2:2})) $((16#${1:4:2})); }
    fa=$(printf %02x "$(awk -v a="$frost_alpha" 'BEGIN{printf "%d", a * 255 + 0.5}')") # frost alpha as a hex byte
    { for k in bg surface raised hover line dim muted text bright error accent; do echo "@define-color o_$k #${!k};"; done
      echo "@define-color o_frost rgba($(rgb "$bg"),$frost_alpha);"; echo "@define-color o_frost_up rgba($(rgb "$raised"),$frost_alpha);"; echo "@define-color o_bar rgba($(rgb "$bg"),$bar_alpha);"; } | put colors.css
    { echo "font=${font_ui//\"/}:size=$size_body,${font_mono//\"/}:size=$size_body"; echo "icon-theme=$icon_theme"
      echo "horizontal-pad=$sp_4"; echo "vertical-pad=$sp_3"; echo "inner-pad=$sp_2"
      printf '[colors]\nbackground=%s%s\ntext=%sff\nmatch=%sff\nselection=%sff\nselection-text=%sff\nselection-match=%sff\nborder=%sff\nprompt=%sff\n' \
        "$bg" "$fa" "$text" "$bright" "$hover" "$bright" "$bright" "$line" "$muted"
      printf '[border]\nwidth=%s\nradius=%s\nselection-radius=%s\n' "$border" "$r_l" "$r_s"; } | put fuzzel.ini
    { for k in bg surface raised hover line dim muted text bright error accent; do echo "\$$k = rgb(${!k})"; done
      echo "\$frost = rgba($bg$fa)"; echo "\$font_ui = ${font_ui//\"/}"
      for k in r_s r_m r_l sp_1 sp_2 sp_3 sp_4 sp_5 size_small size_body size_title size_display border; do echo "\$$k = ${!k}"; done; } | put hyprlock.conf
    { echo "return {"
      for k in bg surface raised hover line dim muted text bright error accent frost_alpha r_s r_m r_l sp_1 sp_2 sp_3 sp_4 sp_5 font_ui font_mono \
        size_small size_body size_title size_display weight_normal weight_bold border cursor_theme cursor_size icon_theme; do
        v=${!k}; v=${v//\"/}; if [[ $v =~ ^[0-9.]+$ && ${#v} -lt 6 ]]; then echo "  $k = $v,"; else echo "  $k = \"$v\","; fi; done
      echo "}"; } | put tokens.lua
    { echo "{"; for k in bg surface raised hover line dim muted text bright error accent; do echo "  \"$k\": \"#${!k}\","; done
      for k in frost_alpha bar_alpha r_s r_m r_l sp_1 sp_2 sp_3 sp_4 sp_5 size_small size_body size_title weight_normal weight_bold border; do echo "  \"$k\": ${!k},"; done
      echo "  \"font_ui\": \"${font_ui//\"/}\","; echo "  \"font_mono\": \"${font_mono//\"/}\""; echo "}"; } | put tokens.json
    I=$HOME/.local/share/icons/Oracle P=/usr/share/icons/Papirus # grey folders: Papirus's own grey set under a small theme of ours (no package)
    if [[ -d $P && ! -f $I/index.theme ]]; then
      for z in 22 24 32 48 64; do mkdir -p "$I/${z}x$z/places"
        for f in "$P/${z}x$z"/places/{folder,user}-grey*.svg; do n=${f##*/}; ln -sf "$f" "$I/${z}x$z/places/${n/-grey/}"; done; done
      { printf '[Icon Theme]\nName=Oracle\nInherits=Papirus-Dark,hicolor\nDirectories=22x22/places,24x24/places,32x32/places,48x48/places,64x64/places\n'
        for z in 22 24 32 48; do printf '\n[%sx%s/places]\nSize=%s\nContext=Places\nType=Fixed\n' $z $z $z; done
        printf '\n[64x64/places]\nSize=64\nMinSize=49\nMaxSize=512\nContext=Places\nType=Scalable\n'; } >"$I/index.theme"
    fi
    if [[ -n $ch ]]; then pkill -USR2 -x waybar || true; swaync-client -rs &>/dev/null || true; fi ;;
  wall) pkill -x swaybg || true; [[ -n ${WAYLAND_DISPLAY:-} ]] || exit 0 # desktop wallpaper (settings), else black
    w=$("$0" get wallpaper); if [[ -f $w ]]; then setsid -f swaybg -i "$w" -m fill &>/dev/null; else setsid -f swaybg -c 000000 &>/dev/null; fi ;;
  idle) # Shell mode (cage; Hyprland has hypridle + lid binds): dim at 5 min, screen off at 7. Never sleeps (server)
    sw() { setsid -f swayidle timeout 300 'brightnessctl -q -s set 10%' resume 'brightnessctl -q -r' \
      timeout 420 'brightnessctl -q set 0' resume 'brightnessctl -q -r' &>/dev/null; }
    # Panel off = ghostty shrinks to a tiny window; pin tmux windows at their size so the dashboard isn't squashed and reflowed on open
    pin() { tmux list-windows -a -F '#{window_id} #{window_width} #{window_height}' 2>/dev/null | while read -r i w h; do tmux resize-window -t "$i" -x "$w" -y "$h"; done; }
    unpin() { tmux list-windows -a -F '#{window_id}' 2>/dev/null | while read -r i; do tmux set -uw -t "$i" window-size; done; }
    if [[ ${2:-} == lid ]]; then # lid shut → panel off (AMD backlight 0 still glows). Pauses swayidle so it can't relight or save 0
      o=$(wlr-randr --json | jq -r '[.[] | select(.name | startswith("eDP"))][0].name // empty') || exit 0; [[ -n $o ]] || exit 0
      p=open
      while pgrep -x cage >/dev/null; do
        s=open; grep -qs closed /proc/acpi/button/lid/*/state && s=closed
        if [[ $s != "$p" ]]; then
          if [[ $s == closed ]]; then pkill -x swayidle || true; pin; wlr-randr --output "$o" --off || true
          else wlr-randr --output "$o" --on --preferred || true
            for _ in {1..25}; do # wait (max 5s) for ghostty to be full size again before tmux follows it
              (($(tmux list-clients -F '#{client_width}' | head -1) >= $(tmux display -p -t oracle '#{window_width}'))) 2>/dev/null && break; sleep 0.2
            done; unpin; sw; fi
          p=$s
        fi
        sleep 2
      done; unpin; exit 0
    fi
    pkill -x swayidle || true; pkill -f 'oracle idle lid$' || true; unpin
    [[ -n ${WAYLAND_DISPLAY:-} && -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || exit 0
    sw; command -v wlr-randr >/dev/null && setsid -f "$0" idle lid &>/dev/null ;;
  night) pkill -x wlsunset || true # night light (settings): warm screen in the evening or always
    [[ -n ${WAYLAND_DISPLAY:-} ]] || exit 0
    case $("$0" get nightlight off) in
      evening) setsid -f wlsunset -t 4000 -T 6500 -S 06:00 -s 18:00 -d 1800 &>/dev/null ;;
      always) setsid -f wlsunset -t 4000 -T 4001 -S 06:00 -s 18:00 &>/dev/null ;;
    esac ;;
  battery) L=/etc/oracle/battery-limit
    if [[ -n ${2:-} ]]; then
      [[ $2 =~ ^[0-9]+$ ]] && ((${2} >= 20 && ${2} <= 100)) || die "usage: oracle battery <20-100>"
      if [[ -w $L ]]; then echo "$2" >"$L"; else echo "$2" | sudo tee "$L" >/dev/null; sudo systemctl start oracle-battery.service; fi
    fi
    echo "battery stops charging at $(cat "$L" 2>/dev/null || echo 100)%" ;;
  gui) if ! hypr; then echo gui >"$MODE"; pkill -x cage; exit; fi # first time: Hyprland replaces cage
    hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null
    if shown; then hyprctl dispatch 'hl.dsp.workspace.toggle_special("shell")' >/dev/null; fi ;;
  shell) hypr || exit 0 # desktop stays running behind Shell mode, apps keep their state
    if ! hyprctl clients | grep -q $'\tclass: oracle.shell$'; then
      setsid -f ghostty --class=oracle.shell --gtk-single-instance=false -e bash -c 'oracle attach; oracle gui' &>/dev/null
      for _ in {1..50}; do hyprctl clients | grep -q $'\tclass: oracle.shell$' && break; sleep 0.1; done
    fi
    if ! shown; then hyprctl dispatch 'hl.dsp.workspace.toggle_special("shell")' >/dev/null; fi
    hyprctl dispatch 'hl.dsp.submap("shell")' >/dev/null ;;
  help | *) "$ME/oracle-manual" --list; echo; echo "more (what, when, examples): press Super+/ or type oracle manual" ;;
esac
